            "minimum": 0.0,
            "title": "Nombre Experiences Precedentes",
            "description": "Nombre d'experiences professionnelles precedentes."
          },
          "annee_experience_totale": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Annee Experience Totale",
