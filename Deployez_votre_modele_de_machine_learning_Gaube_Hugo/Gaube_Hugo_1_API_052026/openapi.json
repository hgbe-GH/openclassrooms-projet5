        "required": [
          "age",
          "genre",
          "revenu_mensuel",
          "statut_marital",
          "departement",
          "poste",
          "nombre_experiences_precedentes",
          "annee_experience_totale",
          "annees_dans_l_entreprise",
          "annees_dans_le_poste_actuel",
          "satisfaction_employee_environnement",
          "note_evaluation_precedente",
          "niveau_hierarchique_poste",
          "satisfaction_employee_nature_travail",
          "satisfaction_employee_equipe",
          "satisfaction_employee_equilibre_pro_perso",
          "note_evaluation_actuelle",
          "heure_supplementaires",
          "augementation_salaire_precedente",
          "nombre_participation_pee",
          "nb_formations_suivies",
          "distance_domicile_travail",
          "niveau_education",
          "domaine_etude",
          "frequence_deplacement",
          "annees_depuis_la_derniere_promotion",
          "annes_sous_responsable_actuel"
        ],
        "title": "EmployeeFeatures",
        "example": {
          "age": 41,
          "annee_experience_totale": 8,
          "annees_dans_l_entreprise": 6,
          "annees_dans_le_poste_actuel": 4,
          "annees_depuis_la_derniere_promotion": 0,
          "annes_sous_responsable_actuel": 5,
          "augementation_salaire_precedente": 11,
          "departement": "Commercial",
          "distance_domicile_travail": 1,
          "domaine_etude": "Infra & Cloud",
          "frequence_deplacement": "Occasionnel",
          "genre": "F",
          "heure_supplementaires": 1,
          "nb_formations_suivies": 0,
          "niveau_education": 2,
          "niveau_hierarchique_poste": 2,
          "nombre_experiences_precedentes": 8,
          "nombre_participation_pee": 0,
          "note_evaluation_actuelle": 3,
          "note_evaluation_precedente": 3,
          "poste": "Cadre Commercial",
          "revenu_mensuel": 5993,
          "satisfaction_employee_environnement": 2,
          "satisfaction_employee_equilibre_pro_perso": 1,
          "satisfaction_employee_equipe": 1,
          "satisfaction_employee_nature_travail": 4,
          "statut_marital": "Celibataire"
        }
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Etat global du service : ok ou degraded."
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded",
            "description": "Indique si l'artefact modele a ete charge."
          },
          "model_path": {
            "type": "string",
            "title": "Model Path",
            "description": "Chemin du modele attendu par l'application."
          },
          "database_connected": {
            "type": "boolean",
            "title": "Database Connected",
            "description": "Indique si PostgreSQL repond."
          },
          "database_logging_enabled": {
            "type": "boolean",
            "title": "Database Logging Enabled",
            "description": "Indique si une configuration PostgreSQL est active."
          },
          "authentication_enabled": {
            "type": "boolean",
            "title": "Authentication Enabled",
            "description": "Indique si `POST /predict` exige une cle `X-API-Key`."
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "Detail technique utile en cas d'etat degrade."
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_loaded",
          "model_path",
          "database_connected",
          "database_logging_enabled",
          "authentication_enabled"
        ],
        "title": "HealthResponse",
        "example": {
          "authentication_enabled": true,
          "database_connected": false,
          "database_logging_enabled": false,
          "model_loaded": true,
          "model_path": "models/attrition_xgboost_pipeline.joblib",
          "status": "ok"
        }
      },
      "PredictionResponse": {
        "properties": {
          "probabilite_attrition": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probabilite Attrition",
            "description": "Probabilite predite d'attrition."
          },
          "prediction_attrition": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Prediction Attrition",
            "description": "Decision binaire finale du modele."
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "description": "Seuil de decision stocke avec l'artefact modele."
          }
        },
        "type": "object",
        "required": [
          "probabilite_attrition",
          "prediction_attrition",
          "threshold"
        ],
        "title": "PredictionResponse",
        "example": {
          "prediction_attrition": 1,
          "probabilite_attrition": 0.7342,
          "threshold": 0.4781
        }
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "tags": [
    {
      "name": "monitoring",
      "description": "Supervision technique du service, du modele et de PostgreSQL."
    },
    {
      "name": "prediction",
      "description": "Inference du modele d'attrition et persistance du logging."
    }
  ]
}
