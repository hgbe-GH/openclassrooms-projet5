          },
          "nb_formations_suivies": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Nb Formations Suivies",
            "description": "Nombre de formations suivies."
          },
          "distance_domicile_travail": {
            "type": "number",
            "minimum": 0.0,
            "title": "Distance Domicile Travail",
            "description": "Distance domicile-travail."
          },
          "niveau_education": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Niveau Education",
